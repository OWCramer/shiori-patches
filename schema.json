{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shiori patch list: one game",
  "type": "object",
  "required": ["appID", "title", "patches"],
  "additionalProperties": false,
  "properties": {
    "appID": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "patches": { "type": "array", "items": { "$ref": "#/$defs/patch" } }
  },
  "$defs": {
    "patch": {
      "type": "object",
      "required": ["id", "name", "kind", "official", "by", "source", "languages", "adult", "status", "verified", "files", "added", "checked"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["adult", "translation", "update", "restoration", "voice", "other"] },
        "official": { "type": "boolean", "description": "Made or published by the game's publisher." },
        "by": { "type": "string", "description": "Publisher or author." },
        "source": {
          "type": "object",
          "required": ["site", "page"],
          "additionalProperties": false,
          "properties": {
            "site": { "enum": ["nekonyan", "saikey", "uncensorpatch", "patchmoe", "vndb", "wingedcloud", "manual"] },
            "page": { "type": "string", "format": "uri" },
            "key": { "type": "string", "description": "What the site calls this patch; the updater matches on it." }
          }
        },
        "version": { "type": ["string", "null"] },
        "languages": { "type": "array", "items": { "type": "string" } },
        "adult": { "type": "boolean" },
        "branch": { "type": ["string", "null"], "description": "Steam beta branch the patch is for, when not the default build." },
        "status": { "enum": ["ok", "dead", "unsupported"], "description": "dead: the link stopped working; unsupported: Shiori can't install it (a Windows installer)." },
        "verified": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "required": ["by", "date"],
              "additionalProperties": false,
              "properties": {
                "by": { "type": "string" },
                "date": { "type": "string", "format": "date" },
                "engine": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          ]
        },
        "notes": { "type": "string" },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "into": { "enum": ["root", "game"], "description": "root: the game's own folder; game: Ren'Py's game/ folder." },
            "strip": { "type": "string", "description": "A wrapper folder in the archive to step into." }
          }
        },
        "files": { "type": "array", "minItems": 1, "description": "Every part of the patch; all of them are installed.", "items": { "$ref": "#/$defs/file" } },
        "added": { "type": "string", "format": "date" },
        "checked": { "type": "string", "format": "date" }
      }
    },
    "file": {
      "type": "object",
      "required": ["host", "url"],
      "additionalProperties": false,
      "properties": {
        "host": {
          "enum": ["direct", "gdrive", "mega", "wetransfer", "steam", "store", "page"],
          "description": "direct/gdrive/mega/wetransfer download in Shiori; steam is a DLC of the game (dlc names it); store is a page to buy it on; page opens in a browser."
        },
        "url": { "type": "string", "format": "uri" },
        "name": { "type": ["string", "null"] },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["zip", "7z", "rar", "exe", "file", null] },
        "installer": { "type": "boolean", "description": "The archive holds a Windows installer instead of the game's files." },
        "dlc": { "type": "integer", "description": "Steam app id of the DLC, for host steam." },
        "mirrors": {
          "type": "array",
          "description": "Other places to get the same file, tried in order when the first fails (or offered when it can't be downloaded in Shiori).",
          "items": {
            "type": "object",
            "required": ["host", "url"],
            "additionalProperties": false,
            "properties": {
              "host": { "enum": ["direct", "gdrive", "mega", "wetransfer", "steam", "store", "page"] },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
